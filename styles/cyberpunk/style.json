{
  "version": 8,
  "name": "Cyberpunk",
  "metadata": {
    "map-room:theme": "cyberpunk",
    "map-room:tileset-schema": "openmaptiles-3.16",
    "map-room:style-version": "1.0.0"
  },
  "sources": {
    "osm": {
      "type": "vector",
      "url": "mbtiles://{osm}"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#060711"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "residential",
          "#101126",
          "industrial",
          "#171028",
          [
            "park",
            "grass",
            "cemetery"
          ],
          "#071f20",
          "#060711"
        ],
        "fill-opacity": 0.78
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "wood",
            "grass"
          ]
        ]
      ],
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#08251f",
          "#071f20"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "paint": {
        "fill-color": "#071f20",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#061b2a"
      }
    },
    {
      "id": "waterway-glow",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#00d9ff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2,
          15,
          7
        ],
        "line-blur": 4,
        "line-opacity": 0.38
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#00d9ff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          15,
          2.2
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#17152d",
        "fill-outline-color": "#ff2aa3",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#9d5cff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.5,
          12,
          1.6
        ],
        "line-dasharray": [
          4,
          2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "roads-glow",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service",
            "path",
            "track"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#ff2aa3",
          "primary",
          "#00e5ff",
          "secondary",
          "#9d5cff",
          "tertiary",
          "#5e6da8",
          [
            "path",
            "track"
          ],
          "#26314f",
          "#35406b"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            2.8,
            1.95
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            6.1,
            "primary",
            5.1,
            "secondary",
            4.2,
            3
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            15.6,
            "primary",
            12.6,
            "secondary",
            10.6,
            7.6
          ]
        ],
        "line-blur": 3,
        "line-opacity": 0.44
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service",
            "path",
            "track"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#080812",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            2.8,
            1.95
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            6.1,
            "primary",
            5.1,
            "secondary",
            4.2,
            3
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            15.6,
            "primary",
            12.6,
            "secondary",
            10.6,
            7.6
          ]
        ],
        "line-opacity": 0.95
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service",
            "path",
            "track"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#ff2aa3",
          "primary",
          "#00e5ff",
          "secondary",
          "#9d5cff",
          "tertiary",
          "#5e6da8",
          [
            "path",
            "track"
          ],
          "#26314f",
          "#35406b"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.2,
            0.35
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            4.5,
            "primary",
            3.5,
            "secondary",
            2.6,
            1.4
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            14,
            "primary",
            11,
            "secondary",
            9,
            6
          ]
        ]
      }
    },
    {
      "id": "rail-glow",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#f7e65b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2,
          15,
          6
        ],
        "line-blur": 3,
        "line-opacity": 0.35
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#f7e65b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          15,
          2
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 9,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#f4f7ff",
        "text-halo-color": "#080912",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          11,
          14,
          15
        ],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#70f7ff",
        "text-halo-color": "#080912",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          12,
          17
        ],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#f4f7ff",
        "text-halo-color": "#080912",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "house-numbers",
      "type": "symbol",
      "source": "osm",
      "source-layer": "housenumber",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "housenumber"
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 9
      },
      "paint": {
        "text-color": "#f4f7ff",
        "text-halo-color": "#080912",
        "text-halo-width": 1
      }
    }
  ]
}
