            ],
            [
              "motorway",
              "trunk"
            ],
            6.8,
            "primary",
            5.7,
            "secondary",
            3.7,
            2.1
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
