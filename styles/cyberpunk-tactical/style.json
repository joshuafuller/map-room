      "id": "operational-landmarks",
      "type": "circle",
      "source": "osm",
      "source-layer": "poi",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "hospital",
            "clinic",
            "police",
            "fire_station",
            "harbor"
