    },
    {
      "id": "waterway-glow",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#00eaff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2,
          15,
          7
        ],
        "line-blur": 4,
        "line-opacity": 0.38
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
