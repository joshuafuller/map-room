          "#172039",
          "#26314e"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
