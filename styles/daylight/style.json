{
  "version": 8,
  "name": "Daylight",
  "metadata": {
    "map-room:theme": "daylight",
    "map-room:tileset-schema": "openmaptiles-3.16"
  },
  "sources": {
    "osm": {
      "type": "vector",
      "url": "mbtiles://{osm}"
    }
  },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1ea"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "osm",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "residential",
          "#e9e5dc",
          "industrial",
          "#ddd8d0",
          [
            "park",
            "grass",
            "cemetery"
          ],
          "#cfe3c5",
          "#f4f1ea"
        ],
        "fill-opacity": 0.78
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "osm",
      "source-layer": "landcover",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "wood",
            "grass"
          ]
        ]
      ],
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#bfd6bb",
          "#cfe3c5"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "osm",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe3c5",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9bc8df"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "osm",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#78b4d2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          15,
          2.2
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "osm",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d5cbc0",
        "fill-outline-color": "#c4b7aa",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "osm",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#9b74a9",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.5,
          12,
          1.6
        ],
        "line-dasharray": [
          4,
          2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service",
            "path",
            "track"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c8c0b5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            2.8,
            1.95
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            6.1,
            "primary",
            5.1,
            "secondary",
            4.2,
            3
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            15.6,
            "primary",
            12.6,
            "secondary",
            10.6,
            7.6
          ]
        ],
        "line-opacity": 0.95
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary",
            "tertiary",
            "minor",
            "service",
            "path",
            "track"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#d98357",
          "primary",
          "#e8b06d",
          "secondary",
          "#f1d49a",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            1.2,
            0.35
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            4.5,
            "primary",
            3.5,
            "secondary",
            2.6,
            1.4
          ],
          16,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "motorway",
              "trunk"
            ],
            14,
            "primary",
            11,
            "secondary",
            9,
            6
          ]
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "osm",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#8c8580",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          15,
          2
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 9,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#293038",
        "text-halo-color": "#fbfaf7",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "water_name",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Italic"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          11,
          14,
          15
        ],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#356c89",
        "text-halo-color": "#fbfaf7",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "osm",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Semibold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          12,
          17
        ],
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#293038",
        "text-halo-color": "#fbfaf7",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "house-numbers",
      "type": "symbol",
      "source": "osm",
      "source-layer": "housenumber",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "get",
          "housenumber"
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 9
      },
      "paint": {
        "text-color": "#293038",
        "text-halo-color": "#fbfaf7",
        "text-halo-width": 1
      }
    }
  ]
}
