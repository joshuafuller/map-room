data/*
!data/.gitkeep
# Ship the glyph directory so Docker does not pre-create the bind-mount source as
# root, which would leave the provisioner unable to write into it.
!data/fonts/
data/fonts/*
!data/fonts/.gitkeep
node_modules/
coverage/
web/vendor/*
!web/vendor/americana-shield-renderer.mjs
!web/vendor/americana-shields.json
styles/regions/
styles/collections/
.gstack/
